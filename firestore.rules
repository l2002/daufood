rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{commentId} {
      // Cho phép mọi người đọc bình luận
      allow read: if true;
      // Cho phép gửi bình luận hợp lệ
      allow create: if request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 2000
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() > 0
                    && request.resource.data.authorName.size() <= 100;
      // Cho phép thả tim / like bình luận
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']);
      allow delete: if false;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    match /presence/{presenceId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
